keywords = {Irrawaddy dolphin ;  Aquatic mammals ;  Cetacea ;  Chlorophyll ;  Coasts ;  Data collection ;  Dolphins ;  Dolphins & porpoises ;  Ecological effects ;  Encroachment ;  Entanglement ;  Environmental planning ;  Fishing gear ;  Fishing vessels ;  Geographical distribution ;  Group size ;  Gulf of Thailand ;  habitat ;  Habitat preferences ;  Habitat utilization ;  Habitats ;  Marine protected areas ;  Marine resources ;  Offshore ;  Orcaella brevirostris ;  Original Research ;  Polls & surveys ;  Protected areas ;  Protected species ;  Salinity ;  spatial management ;  species distribution model ;  Studies ;  Water quality ;  Wildlife conservation},
language = {eng},
