\@writefile{toc}{\contentsline {subsection}{\numberline {S2.2}Prior Sensitivity Analysis}{13}{subsection.2.2}\protected@file@percent }
\newlabel{prior_analysis}{{S2.2}{13}{Prior Sensitivity Analysis}{subsection.2.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S6}{\ignorespaces Prior specifications used in the prior sensitivity analysis for the dolphin-sighting data. Gamma priors use the shape-rate parameterization.\relax }}{13}{table.caption.11}\protected@file@percent }
\newlabel{tab:prior_sensitivity_specs}{{S6}{13}{Prior specifications used in the prior sensitivity analysis for the dolphin-sighting data. Gamma priors use the shape-rate parameterization.\relax }{table.caption.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S6}{\ignorespaces Prior sensitivity analysis for the dolphin-sighting data. Diagnostic $p$-values are shown for the linear HNB, linear NB, nonlinear HNB, and nonlinear NB models under three prior specifications: baseline, tight, and diffuse. Columns correspond to the Shapiro--Wilk test, the ANOVA test against depth, and the omnibus chi-square test. The horizontal dashed line marks the nominal 0.05 level. The qualitative diagnostic conclusions are stable across the three prior specifications: the ANOVA diagnostic continues to reject the linear HNB and NB models, while the nonlinear models are not rejected by the ANOVA diagnostic.\relax }}{14}{figure.caption.12}\protected@file@percent }
\newlabel{fig_prior_sensitivity}{{S6}{14}{Prior sensitivity analysis for the dolphin-sighting data. Diagnostic $p$-values are shown for the linear HNB, linear NB, nonlinear HNB, and nonlinear NB models under three prior specifications: baseline, tight, and diffuse. Columns correspond to the Shapiro--Wilk test, the ANOVA test against depth, and the omnibus chi-square test. The horizontal dashed line marks the nominal 0.05 level. The qualitative diagnostic conclusions are stable across the three prior specifications: the ANOVA diagnostic continues to reject the linear HNB and NB models, while the nonlinear models are not rejected by the ANOVA diagnostic.\relax }{figure.caption.12}{}}
