\@writefile{toc}{\contentsline {section}{\numberline {S1}\leavevmode {\color  {orange}Additional Simulation Studies}}{2}{section.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {S1.1}Simulation Studies with Wrong Families: HNB versus NB}{2}{subsection.1.1}\protected@file@percent }
\newlabel{simulation_wrong_family}{{S1.1}{2}{Simulation Studies with Wrong Families: HNB versus NB}{subsection.1.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S1}{\ignorespaces Visual diagnostics with posterior RSP and MSP Z-residuals for HNB and NB models. The first row displays residual-versus-index plots, with positive count observations and zero observations marked separately for the HNB fits. The second row presents QQ plots of the Z-residuals against the standard normal reference distribution, with Shapiro--Wilk $p$-values reported in the panels. The third row shows the marginal distributions of the Z-residuals, with histograms, empirical kernel densities, and the \(N(0,1)\) reference density overlaid.\relax }}{3}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig_scatter_qq_sim1}{{S1}{3}{Visual diagnostics with posterior RSP and MSP Z-residuals for HNB and NB models. The first row displays residual-versus-index plots, with positive count observations and zero observations marked separately for the HNB fits. The second row presents QQ plots of the Z-residuals against the standard normal reference distribution, with Shapiro--Wilk $p$-values reported in the panels. The third row shows the marginal distributions of the Z-residuals, with histograms, empirical kernel densities, and the \(N(0,1)\) reference density overlaid.\relax }{figure.caption.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S2}{\ignorespaces Empirical distributions of $p$-values for various diagnostic methods under the true HNB model (blue histograms) and the wrong NB model (red histograms), based on 500 replications with sample size $n=100$ and zero proportion $\pi ^o\approx 30\%$. \relax }}{4}{figure.caption.2}\protected@file@percent }
\newlabel{fig_histogram_sim1}{{S2}{4}{Empirical distributions of $p$-values for various diagnostic methods under the true HNB model (blue histograms) and the wrong NB model (red histograms), based on 500 replications with sample size $n=100$ and zero proportion $\mhu \approx 30\%$. \relax }{figure.caption.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S3}{\ignorespaces Empirical model rejection rates for various diagnostic methods under different sample sizes ($n=50, 100, 200$), based on 500 replications with a nominal significance level of 0.05. The rejection rates under the true HNB model (Type I error rates) are shown in black, and the rates under the wrong NB model (power) are shown in red.\relax }}{6}{figure.caption.3}\protected@file@percent }
\newlabel{fig_rejection_rate_sim1}{{S3}{6}{Empirical model rejection rates for various diagnostic methods under different sample sizes ($n=50, 100, 200$), based on 500 replications with a nominal significance level of 0.05. The rejection rates under the true HNB model (Type I error rates) are shown in black, and the rates under the wrong NB model (power) are shown in red.\relax }{figure.caption.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S1}{\ignorespaces Empirical rejection rates for the HNB versus NB wrong-family simulation. The nominal significance level is 0.05. Rejection rates under the correctly specified HNB model estimate type I error rates, whereas rejection rates under the misspecified NB model estimate power. Monte Carlo standard errors can be computed as $\sqrt  {\hat  p(1-\hat  p)/R}$; with $R=500$, the Monte Carlo standard error is approximately 0.010 for a rejection rate near 0.05.\relax }}{6}{table.caption.4}\protected@file@percent }
\newlabel{tab:supp_hnb_nb_rejection_rates}{{S1}{6}{Empirical rejection rates for the HNB versus NB wrong-family simulation. The nominal significance level is 0.05. Rejection rates under the correctly specified HNB model estimate type I error rates, whereas rejection rates under the misspecified NB model estimate power. Monte Carlo standard errors can be computed as $\sqrt {\hat p(1-\hat p)/R}$; with $R=500$, the Monte Carlo standard error is approximately 0.010 for a rejection rate near 0.05.\relax }{table.caption.4}{}}
\BKM@entry{id=3,dest={73756273656374696F6E2E312E32},srcline={425}}{}
\@writefile{toc}{\contentsline {subsection}{\numberline {S1.2}Diagnostics for Mixed Misspecifications in Response Family and Covariate Functional Form Using the Synthetic Dataset from \S  \ref  {M-sec:sim-nl}}{8}{subsection.1.2}\protected@file@percent }
\newlabel{sec:sens_family_function}{{S1.2}{8}{Diagnostics for Mixed Misspecifications in Response Family and Covariate Functional Form Using the Synthetic Dataset from \S \ref {M-sec:sim-nl}}{subsection.1.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S4}{\ignorespaces Posterior RSP Z-residual diagnostics for the NB models fitted to the HNB-generated dataset from Section\nobreakspace  {}\ref  {M-sec:sim-nl} of the main text. Panels (a) and (b) display the NB-log model, which misspecifies the response family while maintaining the correct logarithmic functional form for $X_1$. Panels (c) and (d) illustrate the NB-linear model, which misspecifies both the response family and the functional form of $X_1$. Scatterplots plot posterior RSP Z-residuals against $X_1$, with triangles denoting zero-count observations; boxplots group the residuals across $X_1$ intervals.\relax }}{8}{figure.caption.5}\protected@file@percent }
\newlabel{fig:sens_nb_residual_x1}{{S4}{8}{Posterior RSP Z-residual diagnostics for the NB models fitted to the HNB-generated dataset from Section~\ref {M-sec:sim-nl} of the main text. Panels (a) and (b) display the NB-log model, which misspecifies the response family while maintaining the correct logarithmic functional form for $X_1$. Panels (c) and (d) illustrate the NB-linear model, which misspecifies both the response family and the functional form of $X_1$. Scatterplots plot posterior RSP Z-residuals against $X_1$, with triangles denoting zero-count observations; boxplots group the residuals across $X_1$ intervals.\relax }{figure.caption.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S2}{\ignorespaces Z-residual diagnostic $p$-values for the response-family sensitivity analysis, using the HNB-generated dataset from Section\nobreakspace  {}\ref  {M-sec:sim-nl} of the main text. The HNB-log and HNB-linear models were evaluated in the main text; the NB-log and NB-linear models are introduced here to assess response-family misspecification. Because the response is discrete and RSP Z-residuals depend on auxiliary randomization, we report median upper-bound $p$-values\nobreakspace  {}(Eq.\nobreakspace  {}\textup  {\hbox {\mathsurround \z@ \normalfont  (\ignorespaces \ref  {M-eqn:uppvalue-median}\unskip \@@italiccorr )}}) for the posterior and ISCV RSP Z-residual tests. The AOV and Bartlett (BL) tests are evaluated against $X_1$. The logarithmic form is marked "Wrong" for the NB family because the $X_1$-dependent hurdle probability is improperly absorbed into the NB mean structure (see text).\relax }}{9}{table.caption.6}\protected@file@percent }
\newlabel{tab:sens_family_function}{{S2}{9}{Z-residual diagnostic $p$-values for the response-family sensitivity analysis, using the HNB-generated dataset from Section~\ref {M-sec:sim-nl} of the main text. The HNB-log and HNB-linear models were evaluated in the main text; the NB-log and NB-linear models are introduced here to assess response-family misspecification. Because the response is discrete and RSP Z-residuals depend on auxiliary randomization, we report median upper-bound $p$-values~(Eq.~\eqref {M-eqn:uppvalue-median}) for the posterior and ISCV RSP Z-residual tests. The AOV and Bartlett (BL) tests are evaluated against $X_1$. The logarithmic form is marked "Wrong" for the NB family because the $X_1$-dependent hurdle probability is improperly absorbed into the NB mean structure (see text).\relax }{table.caption.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S5}{\ignorespaces Histograms of 500 replicated Z-residual test $p$-values for the four fitted models. These were obtained by re-randomizing the auxiliary uniform variables, $\bm  {U}$, used to construct the RSPs for the discrete response. The top row presents the SW tests, and the bottom row displays the AOV tests against $X_1$. Red vertical lines denote the corresponding median upper-bound $p$-values\nobreakspace  {}(Eq.\nobreakspace  {}\textup  {\hbox {\mathsurround \z@ \normalfont  (\ignorespaces \ref  {M-eqn:uppvalue-median}\unskip \@@italiccorr )}}) from Table\nobreakspace  {}\ref  {tab:sens_family_function}, and dashed vertical lines indicate the $0.05$ significance level.\relax }}{9}{figure.caption.7}\protected@file@percent }
\newlabel{fig:sens_replicated_pvalue_hist}{{S5}{9}{Histograms of 500 replicated Z-residual test $p$-values for the four fitted models. These were obtained by re-randomizing the auxiliary uniform variables, $\bU $, used to construct the RSPs for the discrete response. The top row presents the SW tests, and the bottom row displays the AOV tests against $X_1$. Red vertical lines denote the corresponding median upper-bound $p$-values~(Eq.~\eqref {M-eqn:uppvalue-median}) from Table~\ref {tab:sens_family_function}, and dashed vertical lines indicate the $0.05$ significance level.\relax }{figure.caption.7}{}}
\BKM@entry{id=4,dest={73756273656374696F6E2E312E33},srcline={492}}{}
\@writefile{toc}{\contentsline {subsection}{\numberline {S1.3}Tabular Rejection Rates of Main-text Simulations}{11}{subsection.1.3}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {S3}{\ignorespaces Rejection rates ($\alpha =0.05$) for the continuous IG simulation (Section\nobreakspace  {}\ref  {M-sec:simulation_piecewise_ig}), showing type I error (``Correct'' piecewise model) and power (``Wrong'' linear model). Tests: Shapiro--Wilk (SW), grouped ANOVA (AOV-$X_1$), and omnibus chi-square ($\chi ^2$).\relax }}{11}{table.caption.8}\protected@file@percent }
\newlabel{tab:supp_ig_rejection_rates}{{S3}{11}{Rejection rates ($\alpha =0.05$) for the continuous IG simulation (Section~\ref {M-sec:simulation_piecewise_ig}), showing type I error (``Correct'' piecewise model) and power (``Wrong'' linear model). Tests: Shapiro--Wilk (SW), grouped ANOVA (AOV-$X_1$), and omnibus chi-square ($\chi ^2$).\relax }{table.caption.8}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S4}{\ignorespaces Rejection rates ($\alpha =0.05$) for the nonlinear HNB simulation (Section\nobreakspace  {}\ref  {M-sec:sim-nl}), showing type I error (``Correct'' logarithmic model) and power (``Wrong'' linear model). Test abbreviations follow Table\nobreakspace  {}\ref  {tab:supp_ig_rejection_rates}.\relax }}{11}{table.caption.9}\protected@file@percent }
\newlabel{tab:supp_hnb_nonlinear_rejection_rates}{{S4}{11}{Rejection rates ($\alpha =0.05$) for the nonlinear HNB simulation (Section~\ref {M-sec:sim-nl}), showing type I error (``Correct'' logarithmic model) and power (``Wrong'' linear model). Test abbreviations follow Table~\ref {tab:supp_ig_rejection_rates}.\relax }{table.caption.9}{}}
