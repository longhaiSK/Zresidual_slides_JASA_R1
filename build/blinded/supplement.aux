\newlabel{fig_binning_sensitivity}{{S7}{15}{Grouped posterior RSP Z-residual boxplots against depth for the linear (top) and nonlinear (bottom) HNB models, evaluated under varying numbers of equally spaced intervals ($k$).\relax }{figure.caption.13}{}}
