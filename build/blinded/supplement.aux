\newlabel{tab:reg_coefs}{{S5}{12}{Regression coefficients for the selected nonlinear HNB model fitted to the dolphin-sighting data. Columns report posterior mean (Estimate), Monte Carlo SE (Est.Error), 95\% credible interval, and $\hat R$.\relax }{table.caption.10}{}}
