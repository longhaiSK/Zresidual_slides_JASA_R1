\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces \leavevmode {\color  {orange}Diagnostic $p$-values and LOO comparisons for the dolphin-sighting data. Rows are grouped into four linear models (HNB, NB, hurdle Poisson, Poisson) and two nonlinear models (HNB, NB). For posterior and ISCV Z-residual tests, we report median upper-bound $p$-values\nobreakspace  {}(eq.\nobreakspace  {}\textup  {\hbox {\mathsurround \z@ \normalfont  (\ignorespaces \ref  {eqn:uppvalue-median}\unskip \@@italiccorr )}}); all Z-AOV tests are conducted against \texttt  {depth}. The last three columns report $\Delta _{\text  {elpd}}$ relative to the nonlinear HNB model, its standard error, and $\qopname  \relax m{Pr}(\Delta _{\text  {elpd}}\ge 0)$.The HPC tests use a splitting ratio of $4:1$ for training and testing.}\relax }}{29}{table.caption.11}\protected@file@percent }
\newlabel{realdata_pvalue}{{2}{29}{\textred {Diagnostic $p$-values and LOO comparisons for the dolphin-sighting data. Rows are grouped into four linear models (HNB, NB, hurdle Poisson, Poisson) and two nonlinear models (HNB, NB). For posterior and ISCV Z-residual tests, we report median upper-bound $p$-values~(eq.~\eqref {eqn:uppvalue-median}); all Z-AOV tests are conducted against \texttt {depth}. The last three columns report $\Delta _{\text {elpd}}$ relative to the nonlinear HNB model, its standard error, and $\Pr (\Delta _{\text {elpd}}\ge 0)$.The HPC tests use a splitting ratio of $4:1$ for training and testing.}\relax }{table.caption.11}{}}
